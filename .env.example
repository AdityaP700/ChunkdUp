# LLM API Keys (optional for basic in-memory use)
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Storage Configuration (required for store="postgres")
DATABASE_URL=postgresql://postgres:password@localhost:5432/chunkdup

# Retrieval Pipeline Configuration
# Options: hybrid_ce_abstain (default), dense_abstain, dense_abstain_ed, baseline_current
CHUNKDUP_RETRIEVAL_CONFIG=hybrid_ce_abstain

# Optional model paths / overrides
# CHUNKDUP_MODELS_DIR=/path/to/models
# CHUNKDUP_EMBEDDING_MODEL=all-MiniLM-L6-v2
# CHUNKDUP_CE_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2
# CHUNKDUP_ENABLE_SPACY_NER=0
